{
  "name": "rhyme-community",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node scripts/ci-migrate.mjs",
    "test": "tsx --test tests/rhyme.test.ts",
    "worker": "wrangler dev --port 8787",
    "types": "wrangler types",
    "deploy": "pnpm run build && wrangler deploy",
    "bootstrap": "node scripts/bootstrap.mjs",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "hono": "^4.13.11",
    "pinyin-pro": "^3.29.4",
    "lucide-react": "^1.48.0",
    "@fontsource/anton": "^5.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "wrangler": "^4.143.1",
    "tsx": "^4.23.15",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@types/node": "^26.6.3"
  }
}